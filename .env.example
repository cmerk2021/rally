# Rally Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
JWT_SECRET=change_me_to_a_random_64_char_string_for_production_use_only

# Docker host ports (only used by docker-compose.yml; the in-container ports stay fixed)
RALLY_PORT=3000
POCKETBASE_PORT=8090

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PocketBase Configuration
POCKETBASE_URL=http://localhost:8090
PB_PORT=8090
POCKETBASE_ADMIN_EMAIL=admin@homelab.local
POCKETBASE_ADMIN_PASSWORD=change_me_strong_password_min_10_chars

# Optional: AI Configuration (can also be set via UI)
AI_ENABLED=false
AI_ENDPOINT=http://ollama:11434/v1
AI_API_KEY=
AI_MODEL=llama3.1:8b
AI_TEMPERATURE=0.2
